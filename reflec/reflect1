/**
 * Receives answers from parts-work.dk/reflect (intake, sessions 1–4 and final)
 * and writes one row per reflection in the "Reflections" tab of this spreadsheet.
 * Also sends the client their "Get a copy by email".
 *
 * Don't press Run on doPost: it only works when the page sends answers.
 * To test from the editor, choose testReflection in the dropdown and press Run.
 *
 * After changing this code: Deploy > Manage deployments > pencil icon >
 * Version: New version > Deploy. The web app URL stays the same.
 */

const REFLECT_SHEET = 'Reflections';
const REFLECT_HEADERS = ['timestamp', 'session', 'name', 'lang', 'q1', 'mood', 'q3', 'q4', 'compass',
                 'use', 'better', 'testimonial', 'share', 'ready', 'note', 'copy_sent_to', 'id'];
const REFLECT_MAIL_NAME = 'Philipp';

function doPost(e) {
  if (!e || !e.postData) {
    throw new Error('doPost only runs when the form sends answers. To test, run testReflection instead.');
  }
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    let data;
    try { data = JSON.parse(e.postData.contents); } catch (err) { data = e.parameter; }
    const sheet = reflectGetSheet_();
    if (data.type === 'copy') reflectSendCopy_(sheet, data);
    else reflectSave_(sheet, data);
    return ContentService.createTextOutput('ok');
  } finally {
    lock.releaseLock();
  }
}

function reflectGetSheet_() {
  const ss = SpreadsheetApp.getActive();
  let sheet = ss.getSheetByName(REFLECT_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(REFLECT_SHEET);
    sheet.getRange(1, 1, 1, REFLECT_HEADERS.length).setValues([REFLECT_HEADERS]).setFontWeight('bold');
    sheet.setFrozenRows(1);
  }
  return sheet;
}

// Current headers, adding any that are missing (so older tabs keep working)
function reflectHeaders_(sheet, keys) {
  let h = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1)).getValues()[0].filter(String);
  const missing = keys.filter(k => h.indexOf(k) === -1);
  if (missing.length) {
    sheet.getRange(1, h.length + 1, 1, missing.length).setValues([missing]).setFontWeight('bold');
    h = h.concat(missing);
  }
  return h;
}

function reflectSave_(sheet, data) {
  delete data.type;
  data.timestamp = data.timestamp ? new Date(data.timestamp) : new Date();
  const h = reflectHeaders_(sheet, REFLECT_HEADERS.concat(Object.keys(data)));
  sheet.appendRow(h.map(k => (k in data ? data[k] : '')));
}

// Sends the client their copy. Only once per reflection, and only for a reflection
// that was actually submitted, so the address can't be used to send random emails.
function reflectSendCopy_(sheet, data) {
  if (!data.id || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email || '')) return;
  const h = reflectHeaders_(sheet, REFLECT_HEADERS);
  const idCol = h.indexOf('id'), sentCol = h.indexOf('copy_sent_to');
  const rows = sheet.getLastRow() > 1 ? sheet.getRange(2, 1, sheet.getLastRow() - 1, h.length).getValues() : [];
  const r = rows.findIndex(row => String(row[idCol]) === String(data.id));
  if (r === -1 || rows[r][sentCol]) return;

  const mail = { to: data.email, subject: String(data.subject || 'Session reflection').slice(0, 200),
                 body: String(data.text || '').slice(0, 20000), name: REFLECT_MAIL_NAME };
  if (data.replyTo) mail.replyTo = data.replyTo;
  MailApp.sendEmail(mail);
  sheet.getRange(r + 2, sentCol + 1).setValue(data.email);
}

// Run this from the editor to test (and to approve permissions the first time)
function testReflection() {
  reflectSave_(reflectGetSheet_(), {
    type: 'reflection', id: 'test-' + Date.now(), session: '2', name: 'Test', lang: 'en',
    q1: 'test answer', mood: 'Clearer', compass: 7, use: 4, ready: 'I want to book the next session'
  });
}
